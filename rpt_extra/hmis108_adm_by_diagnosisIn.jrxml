		<expression><![CDATA[$F{DeadFemaleUnder5}]]></expression>
	</variable>
	<variable name="AliveMaleUnder5" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{AliveMaleUnder5}]]></expression>
	</variable>
	<variable name="DeadMaleUnder5" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{DeadMaleUnder5}]]></expression>
	</variable>
	<variable name="AliveFemaleUnder5" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{AliveFemaleUnder5}]]></expression>
	</variable>
	<variable name="AliveMaleAdult" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{AliveMaleAdult}]]></expression>
	</variable>
	<variable name="DeadMaleAdult" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{DeadMaleAdult}]]></expression>
	</variable>
	<variable name="AliveFemaleAdult" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{AliveFemaleAdult}]]></expression>
	</variable>
	<variable name="DeadFemaleAdult" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{DeadFemaleAdult}]]></expression>
	</variable>
	<variable name="TOTAL_PAGES" incrementType="Report" class="java.lang.Integer">
		<expression><![CDATA[$V{PAGE_COUNT}]]></expression>
	</variable>
	<variable name="LINE_TOTAL" resetType="None" class="java.lang.Long">
		<expression><![CDATA[new Long($F{DeadFemaleUnder5}.longValue()+$F{AliveMaleUnder5}.longValue()+$F{DeadMaleUnder5}.longValue()+
$F{AliveFemaleUnder5}.longValue()+$F{AliveMaleAdult}.longValue()+$F{DeadMaleAdult}.longValue()+
$F{AliveFemaleAdult}.longValue()+$F{DeadFemaleAdult}.longValue())]]></expression>
	</variable>
	<variable name="TOTAL" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$V{LINE_TOTAL}]]></expression>
	</variable>
	<group name="DISEASETYPE">
		<expression><![CDATA[$F{DCL_DESC}]]></expression>
