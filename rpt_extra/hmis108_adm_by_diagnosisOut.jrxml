<jasperReport name="hmis108_adm_by_diagnosisOut" language="java" pageWidth="595" pageHeight="842" whenNoDataType="NoPages" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" resourceBundle="hmis108_adm_by_diagnosisOut" whenResourceMissingType="Key" uuid="9d78b390-7df4-49d5-af10-dc4189e248c6">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import>java.util.*</import>
	<import>net.sf.jasperreports.engine.data.*</import>
	<import>net.sf.jasperreports.engine.*</import>
	<parameter name="year" class="java.lang.String"/>
	<parameter name="month" class="java.lang.String"/>
	<query language="sql"><![CDATA[Select dt.DCL_DESC,d.DIS_DESC,
   (select count(*) from OH_ADMISSION a1
    where a1.ADM_OUT_DIS_ID_A = d.dis_id_a
    and month(ADM_DATE_DIS)=$P{month}
    and year(ADM_DATE_DIS)=$P{year}
    and a1.ADM_DELETED='N'
    and a1.ADM_AGE<5
    and a1.ADM_SEX = 'M'
    and (a1.ADM_DIST_ID_A<>'D' or a1.ADM_DIST_ID_A is null) ) AliveMaleUnder5,
   (select count(*) from OH_ADMISSION a1
    where a1.ADM_OUT_DIS_ID_A = d.dis_id_a
    and month(ADM_DATE_DIS)=$P{month}
    and year(ADM_DATE_DIS)=$P{year}
    and a1.ADM_DELETED='N'
    and a1.ADM_AGE<5
    and a1.ADM_SEX = 'M'
    and a1.ADM_DIST_ID_A='D') DeadMaleUnder5,
   (select count(*) from OH_ADMISSION a1
    where a1.ADM_OUT_DIS_ID_A = d.dis_id_a
    and month(ADM_DATE_DIS)=$P{month}
    and year(ADM_DATE_DIS)=$P{year}
    and a1.ADM_DELETED='N'
    and a1.ADM_AGE<5
    and a1.ADM_SEX = 'F'
    and (a1.ADM_DIST_ID_A<>'D' or a1.ADM_DIST_ID_A is null) ) AliveFemaleUnder5,
   (select count(*) from OH_ADMISSION a1
    where a1.ADM_OUT_DIS_ID_A = d.dis_id_a
    and month(ADM_DATE_DIS)=$P{month}
    and year(ADM_DATE_DIS)=$P{year}
    and a1.ADM_DELETED='N'
    and a1.ADM_AGE<5
    and a1.ADM_SEX = 'F'
    and a1.ADM_DIST_ID_A='D') DeadFemaleUnder5,
   (select count(*) from OH_ADMISSION a1
    where a1.ADM_OUT_DIS_ID_A = d.dis_id_a
    and month(ADM_DATE_DIS)=$P{month}
    and year(ADM_DATE_DIS)=$P{year}
    and a1.ADM_DELETED='N'
    and a1.ADM_AGE>=5
    and a1.ADM_SEX = 'M'
    and (a1.ADM_DIST_ID_A<>'D' or a1.ADM_DIST_ID_A is null) ) AliveMaleAdult,
   (select count(*) from OH_ADMISSION a1
    where a1.ADM_OUT_DIS_ID_A = d.dis_id_a
    and month(ADM_DATE_DIS)=$P{month}
    and year(ADM_DATE_DIS)=$P{year}
    and a1.ADM_DELETED='N'
    and a1.ADM_AGE>=5
    and a1.ADM_SEX = 'M'
    and a1.ADM_DIST_ID_A='D') DeadMaleAdult,
   (select count(*) from OH_ADMISSION a1
    where a1.ADM_OUT_DIS_ID_A = d.dis_id_a
    and month(ADM_DATE_DIS)=$P{month}
    and year(ADM_DATE_DIS)=$P{year}
    and a1.ADM_DELETED='N'
    and a1.ADM_AGE>=5
    and a1.ADM_SEX = 'F'
    and (a1.ADM_DIST_ID_A<>'D' or a1.ADM_DIST_ID_A is null) ) AliveFemaleAdult,
   (select count(*) from OH_ADMISSION a1
    where a1.ADM_OUT_DIS_ID_A = d.dis_id_a
    and month(ADM_DATE_DIS)=$P{month}
    and year(ADM_DATE_DIS)=$P{year}
    and a1.ADM_DELETED='N'
    and a1.ADM_AGE>=5
    and a1.ADM_SEX = 'F'
    and a1.ADM_DIST_ID_A='D') DeadFemaleAdult
    FROM OH_DISEASE d, OH_DISEASETYPE dt
where d.DIS_DCL_ID_A = dt.DCL_ID_A
order by dt.DCL_DESC,d.DIS_DESC]]></query>
	<field name="DCL_DESC" class="java.lang.String"/>
	<field name="DIS_DESC" class="java.lang.String"/>
	<field name="AliveMaleUnder5" class="java.lang.Long"/>
	<field name="DeadMaleUnder5" class="java.lang.Long"/>
	<field name="AliveFemaleUnder5" class="java.lang.Long"/>
	<field name="DeadFemaleUnder5" class="java.lang.Long"/>
	<field name="AliveMaleAdult" class="java.lang.Long"/>
	<field name="DeadMaleAdult" class="java.lang.Long"/>
	<field name="AliveFemaleAdult" class="java.lang.Long"/>
	<field name="DeadFemaleAdult" class="java.lang.Long"/>
	<variable name="AliveMaleUnder5" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{AliveMaleUnder5}]]></expression>
	</variable>
	<variable name="DeadMaleUnder5" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{DeadMaleUnder5}]]></expression>
	</variable>
	<variable name="AliveFemaleUnder5" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{AliveFemaleUnder5}]]></expression>
	</variable>
	<variable name="DeadFemaleUnder5" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{DeadFemaleUnder5}]]></expression>
	</variable>
	<variable name="AliveMaleAdult" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{AliveMaleAdult}]]></expression>
	</variable>
	<variable name="DeadMaleAdult" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{DeadMaleAdult}]]></expression>
	</variable>
	<variable name="AliveFemaleAdult" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{AliveFemaleAdult}]]></expression>
	</variable>
	<variable name="DeadFemaleAdult" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{DeadFemaleAdult}]]></expression>
	</variable>
	<variable name="LINE_TOTAL" resetType="None" class="java.lang.Long">
		<expression><![CDATA[new Long($F{AliveMaleUnder5}.longValue()+$F{DeadMaleUnder5}.longValue()+
$F{AliveFemaleUnder5}.longValue()+$F{DeadFemaleUnder5}.longValue()+
$F{AliveMaleAdult}.longValue()+$F{DeadMaleAdult}.longValue()+
$F{AliveFemaleAdult}.longValue()+$F{DeadFemaleAdult}.longValue())]]></expression>
	</variable>
	<variable name="TOTAL" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$V{LINE_TOTAL}]]></expression>
	</variable>
