		<element kind="staticText" uuid="84cdc960-b010-4811-8dbf-36552b0ea503" key="staticText-15" x="499" y="0" width="10" height="13" forecolor="#000000" fontName="DejaVu Sans" fontSize="6.0" bold="false" hTextAlign="Center" vTextAlign="Middle">
