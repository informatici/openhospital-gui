<jasperReport name="PharmaceuticalAMC_ver2" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="NoPages" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" resourceBundle="PharmaceuticalAMC_ver2" uuid="a8347532-25fa-47d3-9f7f-5e58aa404d36" floatColumnFooter="true">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="NO_DATA_ADAPTER"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<import>net.sf.jasperreports.engine.*</import>
	<import>java.util.*</import>
	<import>net.sf.jasperreports.engine.data.*</import>
	<style name="CritivalValue" forecolor="#000000">
		<conditionalStyle forecolor="#FF0000">
			<conditionExpression><![CDATA[new Boolean (
	$F{SOH}.doubleValue() < $F{MDSR_MIN_STOCK_QTI}.doubleValue()
)]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="Hospital" forPrompting="false" class="java.lang.String"/>
	<parameter name="Address" forPrompting="false" class="java.lang.String"/>
	<parameter name="City" forPrompting="false" class="java.lang.String"/>
	<parameter name="Email" forPrompting="false" class="java.lang.String"/>
	<parameter name="Telephone" forPrompting="false" class="java.lang.String"/>
	<parameter name="Currency" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["ETB"]]></defaultValueExpression>
	</parameter>
	<parameter name="TODAY_DATE" class="java.time.LocalDateTime"/>
	<parameter name="START_DATE" class="java.time.LocalDateTime"/>
	<parameter name="END_DATE" class="java.time.LocalDateTime"/>
	<query language="sql"><![CDATA[SELECT MDSR_ID, MDSR_CODE, MDSR_DESC, MDSR_MIN_STOCK_QTI,
    COALESCE((SELECT MS_BALANCE FROM OH_MEDICALDSRSTOCK
        WHERE MS_MDSR_ID = MDSR_ID
        AND MS_DATE_BALANCE <= $P{TODAY_DATE}
        ORDER BY MS_ID DESC 
        LIMIT 1), 0) AS SOH,
    COALESCE(SUM(MONTH_0), 0) AS CONS_THIS_MONTH, 
    COALESCE(SUM(MONTH_3), 0) / 3 AS AVG_3_MONTHS, 
    COALESCE(SUM(MONTH_6), 0) / 6 AS AVG_6_MONTHS,
    COALESCE(SUM(MONTH_12), 0) / 12 AS AVG_12_MONTHS,
    DOS_12_MONTHS,
    BALANCE_X_DAYS / DATEDIFF($P{END_DATE}, $P{START_DATE}) AS AVG_STOCK_12_MONTHS,
    COALESCE(SUM(MONTH_12), 0) AS CONS_12_MONTHS,
    COALESCE(SUM(MONTH_12), 0) / (BALANCE_X_DAYS / DATEDIFF($P{END_DATE}, $P{START_DATE})) AS IR, 
    (SELECT MS_BALANCE FROM OH_MEDICALDSRSTOCK
        WHERE MS_MDSR_ID = MDSR_ID
        AND MS_DATE_BALANCE <= $P{TODAY_DATE}
        ORDER BY MS_ID DESC 
        LIMIT 1) / (COALESCE(SUM(MONTH_12), 0) / 12) AS COVERAGE,
     COALESCE(SUM(MONTH_12), 0) * DATEDIFF($P{END_DATE}, $P{START_DATE}) / (DATEDIFF($P{END_DATE}, $P{START_DATE}) - DOS_12_MONTHS) AS ADJ_STOCK_12_MONTHS
FROM (
    SELECT MDSR_ID, MDSR_CODE, MDSR_DESC, MDSR_MIN_STOCK_QTI, DATE(MMV_DATE) AS MMV_DATE,
        CASE WHEN MMV_DATE BETWEEN DATE_ADD(LAST_DAY(DATE_SUB($P{TODAY_DATE}, INTERVAL 1 MONTH)), INTERVAL 1 DAY) AND LAST_DAY($P{TODAY_DATE}) THEN SUM(MMV_QTY) END AS MONTH_0,
        CASE WHEN MMV_DATE BETWEEN DATE_ADD(LAST_DAY(DATE_SUB($P{TODAY_DATE}, INTERVAL 4 MONTH)), INTERVAL 1 DAY) AND $P{END_DATE} THEN SUM(MMV_QTY) END AS MONTH_3,
        CASE WHEN MMV_DATE BETWEEN DATE_ADD(LAST_DAY(DATE_SUB($P{TODAY_DATE}, INTERVAL 7 MONTH)), INTERVAL 1 DAY) AND $P{END_DATE} THEN SUM(MMV_QTY) END AS MONTH_6,
        CASE WHEN MMV_DATE BETWEEN $P{START_DATE} AND $P{END_DATE} THEN SUM(MMV_QTY) END AS MONTH_12,
        (SELECT COALESCE(
                SUM(IF(MS_DATE_BALANCE >= $P{START_DATE} AND MS_DATE_NEXT_MOV IS NOT NULL AND MS_DATE_NEXT_MOV <= $P{END_DATE},
                    DATEDIFF(MS_DATE_NEXT_MOV, MS_DATE_BALANCE),
                    IF(MS_DATE_BALANCE >= $P{START_DATE} AND MS_DATE_NEXT_MOV IS NOT NULL AND MS_DATE_NEXT_MOV > $P{END_DATE},
                        DATEDIFF($P{END_DATE}, MS_DATE_BALANCE),
                        IF(MS_DATE_BALANCE < $P{START_DATE} AND MS_DATE_NEXT_MOV IS NOT NULL AND MS_DATE_NEXT_MOV <= $P{END_DATE},
                        DATEDIFF(MS_DATE_NEXT_MOV, $P{START_DATE}),
                        IF(MS_DATE_NEXT_MOV IS NULL,
                            DATEDIFF($P{END_DATE}, MS_DATE_BALANCE),
                            0))))),
                0) AS DOS
            FROM OH_MEDICALDSRSTOCK
            WHERE MS_BALANCE = 0
                AND MS_MDSR_ID = MDSR_ID
                AND MS_DATE_BALANCE BETWEEN $P{START_DATE} AND $P{END_DATE}) AS DOS_12_MONTHS,
        (SELECT COALESCE(
                SUM(IF(MS_DATE_BALANCE >= $P{START_DATE} AND MS_DATE_NEXT_MOV IS NOT NULL AND MS_DATE_NEXT_MOV <= $P{END_DATE},
                DATEDIFF(MS_DATE_NEXT_MOV, MS_DATE_BALANCE) * MS_BALANCE,
                IF(MS_DATE_BALANCE >= $P{START_DATE} AND MS_DATE_NEXT_MOV IS NOT NULL AND MS_DATE_NEXT_MOV > $P{END_DATE},
                    DATEDIFF($P{END_DATE}, MS_DATE_BALANCE) * MS_BALANCE,
                    IF(MS_DATE_BALANCE < $P{START_DATE} AND MS_DATE_NEXT_MOV IS NOT NULL AND MS_DATE_NEXT_MOV <= $P{END_DATE},
                        DATEDIFF(MS_DATE_NEXT_MOV, $P{START_DATE}) * MS_BALANCE,
                        IF(MS_DATE_NEXT_MOV IS NULL,
                            DATEDIFF($P{END_DATE}, MS_DATE_BALANCE) * MS_BALANCE,
                            0))))),
                0) AS BALANCE_X_DAYS
			FROM OH_MEDICALDSRSTOCK
			WHERE MS_MDSR_ID = MDSR_ID
				AND (MS_DATE_BALANCE BETWEEN $P{START_DATE} AND $P{END_DATE}
					OR MS_DATE_NEXT_MOV BETWEEN $P{START_DATE} AND $P{END_DATE})) AS BALANCE_X_DAYS
    FROM OH_MEDICALDSR
        LEFT JOIN OH_MEDICALDSRSTOCKMOV ON MDSR_ID = MMV_MDSR_ID
        LEFT JOIN OH_MEDICALDSRSTOCKMOVTYPE ON MMVT_ID_A = MMV_MMVT_ID_A
    WHERE MMVT_TYPE LIKE '-%' AND MMVT_CATEGORY = 'operational'
        AND MDSR_DELETED = 'N'
    GROUP BY MDSR_ID, DATE_FORMAT(MMV_DATE,'%Y/%m')
    ORDER BY MDSR_ID, DATE(MMV_DATE) DESC) AS MONTHLY
GROUP BY MDSR_CODE]]></query>
	<field name="MDSR_ID" class="java.lang.Integer"/>
	<field name="MDSR_CODE" class="java.lang.String"/>
	<field name="MDSR_DESC" class="java.lang.String"/>
	<field name="MDSR_MIN_STOCK_QTI" class="java.lang.Float"/>
	<field name="SOH" class="java.lang.Long"/>
	<field name="CONS_THIS_MONTH" class="java.lang.Double"/>
	<field name="AVG_3_MONTHS" class="java.lang.Double"/>
	<field name="AVG_6_MONTHS" class="java.lang.Double"/>
	<field name="AVG_12_MONTHS" class="java.lang.Double"/>
	<field name="DOS_12_MONTHS" class="java.math.BigDecimal"/>
	<field name="AVG_STOCK_12_MONTHS" class="java.math.BigDecimal"/>
	<field name="CONS_12_MONTHS" class="java.lang.Double"/>
	<field name="IR" class="java.lang.Double"/>
	<field name="COVERAGE" class="java.lang.Double"/>
